{{ if eq .chezmoi.os "darwin" -}}
{{ $ad_hoc_op_path := joinPath .chezmoi.homeDir ".local" "bin" "op" -}}
{{ $ad_hoc_op_hash := "<none>" -}}
{{ if stat $ad_hoc_op_path -}}
{{ $ad_hoc_op_hash = include $ad_hoc_op_path | sha256sum -}}
{{ end -}}
#!/usr/bin/env bash

# {{ template "dotfiles_bashlib.sh" . }}

# ad-hoc op hash: {{ $ad_hoc_op_hash }}

# Help shellcheck identify the above include
true || source ../.chezmoitemplates/dotfiles_bashlib.sh

dot::chezmoi_script_start "uninstall ad-hoc 1Password CLI"

if [[ ! -e ~/.local/bin/op ]]; then
    dot::chezmoi_script_skipped "ad-hoc op is not installed"
fi

if [[ ! -e /opt/homebrew/bin/op ]]; then
    dot::chezmoi_script_skipped "brew op is not installed, will keep the ad-hoc op"
fi

dot::step "removing ad-hoc op from ~/.local/bin"
rm -f ~/.local/bin/op || dot::die "failed to remove ad-hoc op from ~/.local/bin"

dot::success "ad-hoc 1Password CLI uninstalled"
{{ end -}}
