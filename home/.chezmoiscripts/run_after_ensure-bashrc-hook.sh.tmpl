{{- /*
~/.bashrc is intentionally unmanaged (tools append to it freely, and a
managed file would conflict with that). This script only guarantees that the
line loading the managed bash config is present.

The check happens here at template level: when the hook is already in place
the script renders empty and chezmoi does not run it at all, keeping a clean
apply silent.

The script checks again at run time, because chezmoi renders every template
before running any script: another script in the same apply (the bash
decommission migration, which rewrites ~/.bashrc with the hook in it) can
add the line after this template decided it was missing. Without the second
check the hook would be appended twice.
*/ -}}
{{- $bashrc := joinPath .chezmoi.homeDir ".bashrc" -}}
{{- $hookPresent := output "sh" "-c" (printf "grep -qsF .config/bash/init.bash %s && echo yes || echo no" (shellQuote $bashrc)) | trim -}}
{{- if eq $hookPresent "no" -}}
#!/usr/bin/env bash

# {{ template "dotfiles_bashlib.sh" . }}
# Help shellcheck identify the above include
true || source ../.chezmoitemplates/dotfiles_bashlib.sh

dot::chezmoi_script_start "ensure ~/.bashrc loads the managed bash config"

bashrc="$HOME/.bashrc"

if [[ ! -f $bashrc ]]; then
    dot::step::start "create ~/.bashrc"
    cat > "$bashrc" << 'EOF'
# ~/.bashrc
#
# This file is intentionally NOT managed by chezmoi so that tools can append
# to it freely. The managed bash configuration lives in ~/.config/bash/init.bash
# and is loaded by the line below (kept in place by a chezmoi script).

# shellcheck source=/dev/null
[[ -f ~/.config/bash/init.bash ]] && source ~/.config/bash/init.bash

# -----------------------------------------------------------------------------
# This is where all sort of random commands will append their stuff
# -----------------------------------------------------------------------------
EOF
    dot::step::done
elif grep -qsF .config/bash/init.bash "$bashrc"; then
    dot::step::start "append hook to existing ~/.bashrc"
    dot::step::skipped "already in place (added earlier in this apply)"
else
    dot::step::start "append hook to existing ~/.bashrc"
    cat >> "$bashrc" << 'EOF'

# Managed bash configuration (line kept in place by a chezmoi script)
# shellcheck source=/dev/null
[[ -f ~/.config/bash/init.bash ]] && source ~/.config/bash/init.bash
EOF
    dot::step::done
fi

dot::success "~/.bashrc loads the managed bash config"
{{ end -}}
