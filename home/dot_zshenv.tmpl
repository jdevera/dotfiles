{{ if .is_macos -}}
# ------------------------------------------------------------------------------
# Locale Configuration
# ------------------------------------------------------------------------------
# My macOS is configured with AppleLocale=en_ES (English language, Spain region)
# because I live in Spain but prefer English. Problem is, there's no en_ES Unix
# locale on macOS. The terminal tries to derive locale settings from this, fails,
# and ends up setting LC_CTYPE=UTF-8, which is invalid (locales need the full
# format like en_IE.UTF-8, not just UTF-8). This causes shells to complain.
#
# The fix: explicitly set a valid locale. I use en_IE.UTF-8 (English/Ireland)
# because it gives me:
#   - British English spelling (colour, metre, etc.)
#   - Metric system
#   - Euro currency symbol
#   - 24-hour time format
#   - dd/MM/yyyy date format
# ------------------------------------------------------------------------------
export LANG=en_IE.UTF-8
export LC_ALL=en_IE.UTF-8

# cmux: GHOSTTY_BIN_DIR points at cmux's MacOS/ dir which has no ghostty
# binary, breaking ssh-cache calls in Ghostty's shell integration. Repoint
# to the bundled ghostty (or the host's Ghostty.app) before integration
# loads. https://github.com/manaflow-ai/cmux/issues/1187
if [[ -n "$GHOSTTY_BIN_DIR" && ! -x "$GHOSTTY_BIN_DIR/ghostty" ]]; then
  cmux_bin="${GHOSTTY_BIN_DIR%/MacOS}/Resources/bin"
  if [[ -x "$cmux_bin/ghostty" ]]; then
    export GHOSTTY_BIN_DIR="$cmux_bin"
  elif [[ -x /Applications/Ghostty.app/Contents/MacOS/ghostty ]]; then
    export GHOSTTY_BIN_DIR=/Applications/Ghostty.app/Contents/MacOS
  fi
  unset cmux_bin
fi

{{ end -}}
# Keep .zshenv minimal — it runs for ALL zsh invocations (scripts, subshells, etc.)
# Everything else goes in .zshrc (interactive shells only).
