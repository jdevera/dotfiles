{{- /*
    install_packages.sh.tmpl — Shared package installation template.
    Expects a dict with keys:
      title            — script banner text
      package_names    — list of package names to install
      softwarePackages — the specs registry
      chezmoi          — chezmoi data (for OS detection)
      is_macos         — boolean
      is_linux         — boolean
      has_gui          — boolean
*/ -}}
{{- $chezmoi := .chezmoi -}}
{{- $specs := .softwarePackages -}}
{{- $title := .title -}}
{{- $names := .package_names -}}

{{- /* Method collections */ -}}
{{- $brew := list -}}
{{- $mas := dict -}}
{{- $apt := list -}}
{{- $dnf := list -}}
{{- $copr := list -}}
{{- $dnfrepo := list -}}
{{- $uv := dict -}}
{{- $script := dict -}}
{{- $checks := dict -}}

{{- /* Collect each package under the install method package_method.tmpl
       resolves it to. Packages resolving to mise are not installed here:
       they are declared in a ~/.config/mise/conf.d/ file and installed by
       the mise install script (see mise_install.sh.tmpl). */ -}}
{{- range $name := $names -}}
{{-   if not $name -}}{{- continue -}}{{- end -}}
{{-   $spec := get $specs $name -}}
{{-   $method := includeTemplate "package_method.tmpl" (dict "spec" $spec "os" $chezmoi.os) -}}
{{-   if eq $method "mas" -}}
{{-     $mas = set $mas $name (toString $spec.mas) -}}
{{-   else if eq $method "brew" -}}
{{-     $brew = append $brew (printf "brew %s" ($spec.brew | quote)) -}}
{{-   else if eq $method "cask" -}}
{{-     $brew = append $brew (printf "cask %s" ($spec.cask | quote)) -}}
{{-   else if eq $method "apt" -}}
{{-     $apt = append $apt $spec.apt -}}
{{-   else if eq $method "dnf" -}}
{{-     $val := $spec.dnf -}}
{{-     if kindIs "string" $val -}}
{{-       $dnf = append $dnf $val -}}
{{-     else -}}
{{-       $dnf = append $dnf $val.package -}}
{{-       if hasKey $val "copr" -}}
{{-         $copr = append $copr $val.copr -}}
{{-       end -}}
{{-       if hasKey $val "repo" -}}
{{-         $dnfrepo = append $dnfrepo $val.repo -}}
{{-       end -}}
{{-     end -}}
{{-   else if eq $method "uv" -}}
{{-     $u := $spec.uv -}}
{{-     if kindIs "string" $u -}}
{{-       $uv = set $uv $name (dict "name" $u "with" list) -}}
{{-     else -}}
{{-       $w := list -}}
{{-       if hasKey $u "with" -}}
{{-         if kindIs "string" $u.with -}}
{{-           $w = list $u.with -}}
{{-         else -}}
{{-           $w = $u.with -}}
{{-         end -}}
{{-       end -}}
{{-       $uv = set $uv $name (dict "name" $u.name "with" $w) -}}
{{-     end -}}
{{-   else if eq $method "script" -}}
{{-     $script = set $script $name $spec.script -}}
{{-     if hasKey $spec "check" -}}{{- $checks = set $checks $name $spec.check -}}{{- end -}}
{{-   else if not $method -}}
{{-     warnf "Package %s: no install method for %s" $name $chezmoi.os -}}
{{-   end -}}
{{- end -}}

{{- $hasAny := or (len $brew) (len $mas) (len $apt) (len $dnf) (len $uv) (len $script) -}}
{{- if $hasAny -}}
#!/usr/bin/env bash
{{ if eq $chezmoi.os "darwin" -}}
# macOS build version: {{ output "sw_vers" "--buildVersion" -}}
{{ end }}
# {{- includeTemplate "dotfiles_bashlib.sh" . }}
# Help shellcheck identify the above include
true || source ../.chezmoitemplates/dotfiles_bashlib.sh

dot::chezmoi_script_start {{ $title | shellQuote }}
{{ if $brew }}
dot::step::start "ensure Homebrew is installed"
if ! dot::has_command brew; then
    dot::step::fatal "NOT installed"
fi
dot::step::done

dot::step::start "install formulae and casks"
brew bundle --no-upgrade --file=/dev/stdin <<'BREWEOF' || dot::step::fatal
{{ range $line := $brew -}}
{{ $line }}
{{ end -}}
BREWEOF
dot::step::done
{{ end -}}
{{ if $mas }}
dot::assert_has_commands mas
{{ range $name, $id := $mas }}
dot::step::start {{ printf "install %s from the App Store" $name | shellQuote }}
if mas list 2>/dev/null | grep -q {{ printf "^[[:space:]]*%s[[:space:]]" $id | shellQuote }}; then
    dot::step::skipped "already installed"
else
    mas install {{ $id | shellQuote }} || dot::step::fatal
    dot::step::done
fi
{{ end -}}
{{ end -}}
{{ if $apt }}
dot::step::start "update package sources"
sudo apt update || dot::step::fatal
dot::step::done

dot::step::start "install packages with APT"
sudo apt install --no-upgrade -y \
{{ range $pkg := $apt }}    {{ $pkg | shellQuote }} \
{{ end }}    || dot::step::fatal
dot::step::done
{{ end -}}
{{ if $dnf }}
{{ if $copr -}}
dot::step::start "enable COPR repositories"
{{ range $repo := ($copr | uniq) -}}
if ! dnf repolist 2>/dev/null | grep -q {{ printf "copr.*%s" ($repo | replace "/" ".*") | shellQuote }}; then
    sudo dnf copr enable -y {{ $repo | shellQuote }}
fi
{{ end -}}
dot::step::done
{{ end }}
{{ if $dnfrepo -}}
dot::step::start "add DNF repositories"
{{ range $repo := ($dnfrepo | uniq) -}}
if [[ ! -f {{ joinPath "/etc/yum.repos.d" (base $repo) | shellQuote }} ]]; then
    sudo dnf config-manager addrepo --from-repofile={{ $repo | shellQuote }}
fi
{{ end -}}
dot::step::done
{{ end }}
dot::step::start "install packages with DNF"
sudo dnf install --skip-unavailable -y \
{{ range $pkg := $dnf }}    {{ $pkg | shellQuote }} \
{{ end }}    || dot::step::fatal
dot::step::done
{{ end -}}
{{ if $uv }}
dot::assert_has_commands uv jq yq

currently_installed_tools_json="$(
    for f in ~/.local/share/uv/tools/*/uv-receipt.toml
    do
        [[ -f $f ]] || continue
        yq -p toml -o json "$f"
    done |
        jq -s '
            map(
                .tool.requirements
                | select(length>0)
                | {key: .[0].name, value: (.[1:] | map(.name) | unique)}
            )
            | from_entries
            ')"

function is_already_installed() {
    local package_name=$1
    local deps=$2
    local result="$(echo "$currently_installed_tools_json" |
        jq --arg pkg "$package_name" \
           --argjson deps "$deps" \
           'has($pkg) and ((.[$pkg] | sort) == ($deps | sort))')"
    [[ $result == true ]]
}
{{ range $name, $pkg := $uv }}
if ! is_already_installed {{ $name | shellQuote }} {{ $pkg.with | toJson | shellQuote }}
then
    dot::step::start {{ printf "install uv tool: %s" $name | shellQuote }}
    uv tool install {{ range $pkg.with }}--with {{ . | shellQuote }} {{ end }}{{ $pkg.name | shellQuote }}
    dot::step::done
fi
{{ end -}}
{{ end -}}
{{ if $script }}
{{ range $name, $cmd := $script -}}
{{ if hasKey $checks $name -}}
dot::step::start {{ printf "install %s via script" $name | shellQuote }}
if dot::has_command {{ (get $checks $name).command | shellQuote }}; then
    dot::step::skipped "already installed"
else
    {{ $cmd }}
    dot::step::done
fi
{{ else -}}
dot::step::start {{ printf "install %s via script" $name | shellQuote }}
{{ $cmd }}
dot::step::done
{{ end -}}
{{ end -}}
{{ end -}}
{{- end -}}
