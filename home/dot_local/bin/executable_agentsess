#!/usr/bin/env bash
# agentsess: list/count/resume Claude Code and Codex CLI sessions for a cwd.
set -euo pipefail

CLAUDE_PROJECTS="${CLAUDE_PROJECTS:-$HOME/.claude/projects}"
CODEX_SESSIONS="${CODEX_SESSIONS:-$HOME/.codex/sessions}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agentsess"
CODEX_INDEX="$CACHE_DIR/codex-index.tsv"
CODEX_INDEX_HEADER="# agentsess-index-v2"

_claude_dir_for() {
    # Claude encodes cwd by replacing both '/' and '.' with '-'.
    local encoded=${1//\//-}
    encoded=${encoded//./-}
    printf '%s/%s' "$CLAUDE_PROJECTS" "$encoded"
}

_codex_index_stale() {
    # Stale if the index is missing/old-format, or a Codex day dir is newer.
    [[ -f $CODEX_INDEX ]] || return 0
    [[ -d $CODEX_SESSIONS ]] || return 1
    local header day_dir
    IFS= read -r header < "$CODEX_INDEX" || return 0
    [[ $header == "$CODEX_INDEX_HEADER" ]] || return 0
    for day_dir in "$CODEX_SESSIONS"/*/*/*; do
        [[ -d $day_dir && $day_dir -nt $CODEX_INDEX ]] && return 0
    done
    return 1
}

_codex_index_rebuild() {
    mkdir -p "$CACHE_DIR"
    local tmp; tmp=$(mktemp "$CODEX_INDEX.XXXXXX")
    # Each rollout-*.jsonl: first line is session_meta with cwd + id.
    # Emit stable metadata only: cwd \t id \t file_path. One awk process
    # handles a batch of files instead of spawning head/sed/stat per session.
    {
        printf '%s\n' "$CODEX_INDEX_HEADER"
        if [[ -d $CODEX_SESSIONS ]]; then
            find "$CODEX_SESSIONS" -type f -name 'rollout-*.jsonl' \
                -exec awk '
                    FNR == 1 {
                        cwd = id = ""
                        if (match($0, /"cwd":"[^"]*"/))
                            cwd = substr($0, RSTART + 7, RLENGTH - 8)
                        if (match($0, /"id":"[^"]*"/))
                            id = substr($0, RSTART + 6, RLENGTH - 7)
                        if (cwd != "" && id != "")
                            print cwd "\t" id "\t" FILENAME
                        nextfile
                    }
                ' {} + 2>/dev/null
        fi
    } > "$tmp"
    mv "$tmp" "$CODEX_INDEX"
}

_codex_index_refresh_async() {
    # Prompt counts may be one render behind, but must never wait for a scan.
    (_codex_index_rebuild) </dev/null >/dev/null 2>&1 &
}

_codex_index_ensure() {
    _codex_index_stale && _codex_index_rebuild
    [[ -f $CODEX_INDEX ]] || : > "$CODEX_INDEX"
}

_codex_index_ensure_for_count() {
    if _codex_index_stale; then
        _codex_index_refresh_async
    fi
    return 0
}

_claude_jsonls_for() {
    # Print absolute paths of top-level <uuid>.jsonl files for given cwd.
    local d; d=$(_claude_dir_for "$1")
    [[ -d $d ]] || return 0
    find "$d" -maxdepth 1 -type f -name '*.jsonl' 2>/dev/null
}

_codex_entries_for() {
    # Print TSV rows (id, mtime, path) for given cwd, sorted by mtime desc.
    local cwd="$1"
    _codex_index_ensure
    # Timestamps are live metadata needed by list/pick, not prompt counts.
    local id f mt
    while IFS=$'\t' read -r id f; do
        [[ -n $id && -n $f ]] || continue
        mt=$(stat -f '%m' "$f" 2>/dev/null || stat -c '%Y' "$f" 2>/dev/null) || mt=0
        printf '%s\t%s\t%s\n' "$id" "$mt" "$f"
    done < <(awk -F'\t' -v c="$cwd" '$1 == c { print $2 "\t" $3 }' "$CODEX_INDEX") \
        | sort -t $'\t' -k2,2nr
}

_first_user_msg_claude() {
    # First user-role message text from a Claude jsonl, truncated.
    local f="$1"
    awk '
        /"type":"user"/ {
            # crude extract of message.content if it is a string
            if (match($0, /"content":"([^"\\]|\\.)*"/)) {
                s = substr($0, RSTART+11, RLENGTH-12)
                gsub(/\\n/, " ", s); gsub(/\\"/, "\"", s)
                print s
                exit
            }
            # otherwise look for first text in content array
            if (match($0, /"text":"([^"\\]|\\.)*"/)) {
                s = substr($0, RSTART+8, RLENGTH-9)
                gsub(/\\n/, " ", s); gsub(/\\"/, "\"", s)
                print s
                exit
            }
        }
    ' "$f" 2>/dev/null | cut -c1-100
}

_first_user_msg_codex() {
    # First user message from a Codex rollout jsonl, skipping the
    # environment_context wrapper that Codex always injects first.
    local f="$1"
    awk '
        /"role":"user"/ && /"type":"message"/ {
            if (match($0, /"text":"([^"\\]|\\.)*"/)) {
                s = substr($0, RSTART+8, RLENGTH-9)
                if (s ~ /^<environment_context>/) next
                gsub(/\\n/, " ", s); gsub(/\\"/, "\"", s)
                print s
                exit
            }
        }
    ' "$f" 2>/dev/null | cut -c1-100
}

cmd_count() {
    local cwd="${1:-$PWD}" format="${FORMAT:-plain}"
    local cn=0 xn claude_dir f
    claude_dir=$(_claude_dir_for "$cwd")
    if [[ -d $claude_dir ]]; then
        for f in "$claude_dir"/*.jsonl; do
            if [[ -f $f ]]; then
                cn=$((cn + 1))
            fi
        done
    fi
    _codex_index_ensure_for_count
    if [[ -f $CODEX_INDEX ]]; then
        xn=$(awk -F'\t' -v c="$cwd" '$1 == c { n++ } END { print n + 0 }' "$CODEX_INDEX")
    else
        xn=0
    fi
    # Built-in output modes:
    case "$format" in
        json)  printf '{"claude":%s,"codex":%s}\n' "$cn" "$xn"; return ;;
        plain)
            [[ ${HIDE_ZERO:-0} == 1 && $cn == 0 && $xn == 0 ]] && return
            printf 'claude=%s codex=%s\n' "$cn" "$xn"; return ;;
    esac
    # Template mode. HIDE_ZERO=1 hides whichever side has count 0:
    # split FORMAT on '||' and drop sections whose only placeholder is 0.
    if [[ ${HIDE_ZERO:-0} == 1 && $cn == 0 && $xn == 0 ]]; then
        return
    fi
    local out=""
    if [[ ${HIDE_ZERO:-0} == 1 && $format == *'||'* ]]; then
        local rest="$format" seg
        while [[ -n $rest ]]; do
            if [[ $rest == *'||'* ]]; then
                seg="${rest%%||*}"; rest="${rest#*||}"
            else
                seg="$rest"; rest=""
            fi
            [[ $seg == *'{claude}'* && $cn == 0 && $seg != *'{codex}'* ]] && continue
            [[ $seg == *'{codex}'*  && $xn == 0 && $seg != *'{claude}'* ]] && continue
            local sub=${seg//\{claude\}/$cn}
            out+="${sub//\{codex\}/$xn}"
        done
    else
        out=${format//\{claude\}/$cn}
        out=${out//\{codex\}/$xn}
    fi
    printf '%s\n' "$out"
}

cmd_list() {
    local cwd="${1:-$PWD}"
    # Claude rows
    while IFS= read -r f; do
        [[ -z $f ]] && continue
        local id mt preview ts
        id=$(basename "$f" .jsonl)
        mt=$(stat -f '%m' "$f" 2>/dev/null || stat -c '%Y' "$f" 2>/dev/null)
        ts=$(date -r "$mt" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$mt" '+%Y-%m-%d %H:%M')
        preview=$(_first_user_msg_claude "$f")
        printf 'claude\t%s\t%s\t%s\n' "$id" "$ts" "$preview"
    done < <(_claude_jsonls_for "$cwd")
    # Codex rows
    while IFS=$'\t' read -r id mt f; do
        [[ -z $id ]] && continue
        local ts preview
        ts=$(date -r "$mt" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$mt" '+%Y-%m-%d %H:%M')
        preview=$(_first_user_msg_codex "$f")
        printf 'codex\t%s\t%s\t%s\n' "$id" "$ts" "$preview"
    done < <(_codex_entries_for "$cwd")
}

cmd_resume() {
    local id="${1:?usage: agentsess resume <session-id>}"
    # Detect which agent owns the id.
    if find "$CLAUDE_PROJECTS" -maxdepth 2 -type f -name "$id.jsonl" -print -quit 2>/dev/null | grep -q .; then
        exec claude --resume "$id"
    fi
    _codex_index_ensure
    if awk -F'\t' -v id="$id" '$2 == id { found=1; exit } END { exit !found }' "$CODEX_INDEX"; then
        exec codex resume "$id"
    fi
    echo "agentsess: session id not found in claude or codex stores: $id" >&2
    exit 1
}

cmd_pick() {
    # Interactive picker via fzf, then resume.
    command -v fzf >/dev/null || { echo "agentsess: fzf not found" >&2; exit 1; }
    local sel
    sel=$(cmd_list "${1:-$PWD}" | fzf \
        --delimiter=$'\t' --with-nth=1,3,4 \
        --preview='echo {2}' --preview-window=hidden \
        --header='agent  date              first message') || return 130
    [[ -z $sel ]] && return 0
    local id; id=$(printf '%s' "$sel" | cut -f2)
    cmd_resume "$id"
}

cmd_refresh() {
    _codex_index_rebuild
    echo "rebuilt: $CODEX_INDEX"
}

usage() {
    cat <<'EOF'
agentsess - inspect Claude Code and Codex CLI sessions for a directory

Usage:
  agentsess count   [DIR]    print counts (claude=N codex=M)
  agentsess list    [DIR]    TSV rows: agent<TAB>id<TAB>date<TAB>preview
  agentsess pick    [DIR]    fzf picker, resume selection
  agentsess resume  <ID>     resume a specific session (auto-detects agent)
  agentsess refresh          force-rebuild the codex index

Env:
  FORMAT=json|plain|<tmpl>   count output format. Templates may use
                             {claude} and {codex}.
EOF
}

main() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        count)   cmd_count "$@" ;;
        list)    cmd_list "$@" ;;
        pick)    cmd_pick "$@" ;;
        resume)  cmd_resume "$@" ;;
        refresh) cmd_refresh "$@" ;;
        ""|-h|--help|help) usage ;;
        *) echo "agentsess: unknown subcommand: $sub" >&2; usage >&2; exit 2 ;;
    esac
}

main "$@"
